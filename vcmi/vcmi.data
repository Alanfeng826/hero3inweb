	"name" : "Extended lobby options",
	"description" : "Additional options to configure new game maps: extended RMG settings, chess timer",
	"version" : "2.1",
	"author" : "Nordsoft",
	"contact" : "nordsoft@yahoo.com",
	"modType" : "Interface",
	"compatibility":
	{
		"min" : "1.4.0"
	},
	"changelog":
	{
		"1.0": ["Initial version"],
		"1.1": ["Fix problem with template list"],
		"1.2": ["Adopt new translation schema"],
		"1.3": ["Change callbacks according to latest develop changes"],
		"2.0": ["Options tab is widget, RMG options refactoring, chess timer"],
		"2.1": ["Added simturns widget, timers layout change"]
	}
}
{
	"type": "Container",
	"items": [
		{
			"type": "Grid",
			"width": 156,
			"height": 50,
			"columns": 3,
			"top": 120,
			"items": [
				{ "type": "Button", "def": "hdmod/armRight.DEF", "hover": "Move all army to the right", "click": "@controller.moveArmyToTheRight()" },
				{ "type": "Button", "def": "hdmod/swapAll.DEF", "hover": "Swap armies", "click": "@controller.swapArmy()" },
				{ "type": "Button", "def": "hdmod/armLeft.DEF", "hover": "Move all army to the left", "click": "@controller.moveArmyToTheLeft()" },
				{ "type": "Button", "def": "hdmod/artRight.DEF", "hover": "Move all artifacts to the right", "click": "@controller.moveArtsToTheRight()" },
				{ "type": "Button", "def": "hdmod/swapAll.DEF", "hover": "Swap artifacts", "click": "@controller.swapArts()" },
				{ "type": "Button", "def": "hdmod/artLeft.DEF", "hover": "Move all artifacts to the left", "click": "@controller.moveArtsToTheLeft()" }
			]
		},
		{
			"type": "Grid",
			"width": 257,
			"height": 22,
			"columns": 7,
			"top": 153,
			"left": 66,
			"items": [
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(0)" },
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(1)" },
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(2)" },
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(3)" },
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(4)" },
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(5)" },
				{ "type": "Button", "def": "hdmod/unitRight.DEF", "hover": "Move unit to the right", "click": "@controller.moveUnitToTheRight(6)" }
			]
		},
		{
			"type": "Grid",
			"width": 257,
			"height": 22,
			"columns": 7,
			"top": 153,
			"left": 484,
			"items": [
				{ "type": "Button", "def": "hdmod/unitLeft.DEF", "hover": "Move unit to the left", "click": "@controller.moveUnitToTheLeft(0)" },
				{ "type": "Button", "def": "hdmod/unitLeft.DEF", "hover": "Move unit to the left", "click": "@controller.moveUnitToTheLeft(1)" },
