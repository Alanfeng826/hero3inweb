								{
									"type" : "string",
									"description" : "Display name of an account"
								}
							}
						}
					},
					"status" :
					{
						"type" : "string",
						"enum" : [ "idle", "public", "private", "busy", "cancelled", "closed" ],
						"description" : "Current status of game room"
					},
					"playerLimit" :
					{
						"type" : "number",
						"minimum" : 1,
						"maximum" : 8,
						"description" : "Maximum number of players that can join this room, including host"
					},
